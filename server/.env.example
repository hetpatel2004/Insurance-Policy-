# Server environment variables.
# Copy this file to .env and fill in the values, then run `npm run seed`.
NODE_ENV=production
PORT=5000
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/Insurance-Policy?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# If frontend is hosted separately (e.g. Vercel), set FRONTEND_URL for CORS:
FRONTEND_URL=https://your-frontend-domain.com

# Optional: Custom initial password for bootstrap admin accounts (defaults to admin123)
ADMIN_SEED_PASSWORD=change_this_to_a_secure_admin_password
